# ==============================================================================
# TradeSignal India v0.2.0 - Environment Configuration
# ==============================================================================

APP_NAME="TradeSignal India"
APP_VERSION="0.2.0"

# Operating Mode:
# - DEVELOPMENT : Local mocks and testing
# - PAPER       : Live websocket/REST market data feed with zero-risk simulated order execution
# - LIVE_DATA   : Live market data feed + live broker order placement via Groww/Kite
ENVIRONMENT="PAPER"
DEBUG=False

HOST="0.0.0.0"
PORT=8000

# Infrastructure URLs (PostgreSQL & Redis for real-time order state & caching)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradesignal_db
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# BROKER CONFIGURATION (Groww / Zerodha Kite Connect)
# ==============================================================================

# 1. Groww API Integration (Default)
GROWW_API_BASE_URL=https://api.groww.in
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_TOTP_SECRET=
BROKER_AUTH_MODE=TOTP
BROKER_HTTP_TIMEOUT_SECONDS=10

# 2. Zerodha Kite Connect v3 (Alternative)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ==============================================================================
# QUANTITATIVE STRATEGY & INSTITUTIONAL RISK CONTROLS
# ==============================================================================

# Minimum composite multi-factor score to generate trade setups (Range: 0 - 100)
SIGNAL_SCORE_THRESHOLD=80

# Hard Daily Capital Protection
MAX_DAILY_LOSS_RUPEES=3000
MAX_DAILY_SIGNALS=5
MIN_RISK_REWARD=1.5
EVENT_RISK_WINDOW_MINUTES=20

# Scheduled high-impact macro events to automatically VETO trades:
# Example: [{"timestamp":"2026-10-07T08:30:00+05:30","name":"RBI MPC Rate Decision","risk_level":"EXTREME"}]
HIGH_RISK_EVENTS_JSON=[]

# ==============================================================================
# INDIAN DERIVATIVES CONTRACT SPECIFICATIONS & STATUTORY CHARGES (2026 SEBI/NSE)
# ==============================================================================

NIFTY_LOT_SIZE=65
BANKNIFTY_LOT_SIZE=30
FINNIFTY_LOT_SIZE=60
MIDCPNIFTY_LOT_SIZE=120

# Statutory Cost Structure (April 1, 2026 Revision)
OPTION_SELL_STT_RATE=0.0015
OPTION_EXCHANGE_TURNOVER_RATE=0.0003503
OPTION_STAMP_DUTY_RATE=0.00003
SEBI_TURNOVER_PER_CRORE=10
BROKERAGE_PER_ORDER=20
GST_RATE=0.18

# ==============================================================================
# REAL-TIME NOTIFICATIONS & DISPATCH
# ==============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
